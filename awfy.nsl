  class JsonParser with: string = (
  | private input = string.
    private index ::= 0.
    private line  ::= 1.
    private column ::= 0.
    private current ::= nil.
    private captureBuffer ::= ''.
    private captureStart ::= -1.
    private captureStream = platform ReadStream on: string.
    (* AWFY's NULL/TRUE/FALSE are module slots; an nsl fragment cannot add one, so the parser
       holds them: three objects per parse. *)
    private NULL  = JsonLiteral new: 'null'.
    private TRUE  = JsonLiteral new: 'true'.
    private FALSE = JsonLiteral new: 'false'.
  |)(
    public parse = (
      | result |
      self read.
      self skipWhiteSpace.
      result:: self readValue.
      self skipWhiteSpace.
      self isEndOfText ifFalse: [ self error: 'Unexpected character' ].
      ^ result
    )

    private readValue = (
      current = 110 ifTrue: [ ^ self readNull   ].  (* n *)
      current = 116 ifTrue: [ ^ self readTrue   ].  (* t *)
      current = 102 ifTrue: [ ^ self readFalse  ].  (* f *)
      current = 34  ifTrue: [ ^ self readString ].  (* " *)
      current = 91  ifTrue: [ ^ self readArray  ].  (* [ *)
      current = 123 ifTrue: [ ^ self readObject ].  (* { *)

      current = 45 ifTrue: [ ^ self readNumber ].   (* - *)
      current = 48 ifTrue: [ ^ self readNumber ].   (* 0 *)
      current = 49 ifTrue: [ ^ self readNumber ].
      current = 50 ifTrue: [ ^ self readNumber ].
      current = 51 ifTrue: [ ^ self readNumber ].
      current = 52 ifTrue: [ ^ self readNumber ].
      current = 53 ifTrue: [ ^ self readNumber ].
      current = 54 ifTrue: [ ^ self readNumber ].
      current = 55 ifTrue: [ ^ self readNumber ].
      current = 56 ifTrue: [ ^ self readNumber ].
      current = 57 ifTrue: [ ^ self readNumber ].   (* 9 *)

      (* else *)
      self expected: 'value'
    )

    private readArrayElement: array = (
      self skipWhiteSpace.
      array add: self readValue.
      self skipWhiteSpace
    )

    private readArray = (
      | array |
      self read.
      array:: JsonArray new.

      (* Array might be empty *)
      self skipWhiteSpace.
      (self readChar: 93) ifTrue: [ ^ array ].         (* ] *)

      self readArrayElement: array.
      [ self readChar: 44 ] whileTrue: [               (* , *)
        self readArrayElement: array ].

      (self readChar: 93) ifFalse: [                   (* ] *)
        self expected: '"," or "]"' ].
      ^ array
    )

    private readObjectKeyValuePair: object = (
      | name |
      self skipWhiteSpace.
      name:: self readName.
      self skipWhiteSpace.

      (self readChar: 58) ifFalse: [ self expected: ':' ].   (* : *)

      self skipWhiteSpace.

      object add: name with: self readValue.

      self skipWhiteSpace
    )

    private readObject = (
      | object |
      self read.
      object:: JsonObject new.
      self skipWhiteSpace.

      (self readChar: 125) ifTrue: [ ^ object ].       (* } *)

      self readObjectKeyValuePair: object.
      [ self readChar: 44 ] whileTrue: [               (* , *)
        self readObjectKeyValuePair: object ].

      (self readChar: 125) ifFalse: [                  (* } *)
        self expected: '"," or "}"' ].

      ^ object
    )

    private readName = (
      current = 34 ifFalse: [ self expected: 'name' ].  (* " *)
      ^ self readStringInternal
    )

    private readNull = (
      self read.
      self readRequiredChar: 117.  (* u *)
      self readRequiredChar: 108.  (* l *)
      self readRequiredChar: 108.  (* l *)
      ^ NULL
    )

    private readTrue = (
      self read.
      self readRequiredChar: 114.  (* r *)
      self readRequiredChar: 117.  (* u *)
      self readRequiredChar: 101.  (* e *)
      ^ TRUE
    )

    private readFalse = (
      self read.
      self readRequiredChar: 97.   (* a *)
      self readRequiredChar: 108.  (* l *)
      self readRequiredChar: 115.  (* s *)
      self readRequiredChar: 101.  (* e *)
      ^ FALSE
    )

    private readRequiredChar: ch = (
      (self readChar: ch) ifFalse: [
        self expected: 'character: ' , ch printString ]
    )

    private readString = (
      ^ JsonString new: self readStringInternal
    )

    private readStringInternal = (
      | string |
      self read.
      self startCapture.

      [ current = 34 ] whileFalse: [                   (* " *)
        current = 92 ifTrue: [                         (* \ *)
          self pauseCapture.
          self readEscape.
          self startCapture
        ] ifFalse: [
          (* if (current < 0x20) { throw expected('valid string character'); }
             -- AWFY skips this check too. *)
          self read ] ].
      string:: self endCapture.
      self read.
      ^ string
    )

    (* Answers the escaped byte; readEscape makes it a String (never reached by the benchmark:
       its input has no escapes). *)
    private readEscapeChar = (
      current = 34  ifTrue: [ ^ 34 ].   (* " *)
      current = 47  ifTrue: [ ^ 47 ].   (* / *)
      current = 92  ifTrue: [ ^ 92 ].   (* \ *)

      current = 98  ifTrue: [ ^ 8  ].   (* b *)
      current = 102 ifTrue: [ ^ 12 ].   (* f *)
      current = 110 ifTrue: [ ^ 10 ].   (* n *)
      current = 114 ifTrue: [ ^ 13 ].   (* r *)
      current = 116 ifTrue: [ ^ 9  ].   (* t *)

      self expected: 'valid escape sequence. note, some are not supported'
    )

    private readEscape = (
      | ws |
      self read.
      ws:: platform WriteStream new.
      ws nextPut: self readEscapeChar.
      captureBuffer:: captureBuffer , ws contents.
      self read
    )

    private readNumber = (
      | firstDigit |
      self startCapture.
      self readChar: 45.                               (* - *)
      firstDigit:: current.

      self readDigit ifFalse: [ self expected: 'digit' ].
      (firstDigit = 48) not ifTrue: [ [ self readDigit ] whileTrue ].   (* 0 *)

      self readFraction.
      self readExponent.
      ^ JsonNumber new: self endCapture
    )

    private readFraction = (
      (self readChar: 46) ifFalse: [ ^ false ].        (* . *)

      self readDigit ifFalse: [ self expected: 'digit' ].

      [ self readDigit ] whileTrue.

      ^ true
    )

    private readExponent = (
      ((self readChar: 101) not and: [                 (* e *)
        (self readChar: 69) not ]) ifTrue: [ ^ false ].   (* E *)

      (self readChar: 43) ifFalse: [ self readChar: 45 ].  (* + - *)

      self readDigit ifFalse: [ self expected: 'digit' ].

      [ self readDigit ] whileTrue.

      ^ true
    )

    private readChar: ch = (
      current = ch ifFalse: [ ^ false ].
      self read.
      ^ true
    )

    private readDigit = (
      self isDigit ifFalse: [ ^ false ].
      self read.
      ^ true
    )

    private skipWhiteSpace = (
      [ self isWhiteSpace ]
        whileTrue:
          [ self read ]
    )

    private read = (
      current = 10 ifTrue: [                           (* \n *)
        line:: line + 1.
        column:: 0 ].

      index:: index + 1.
      column:: column + 1.

      input isNil ifTrue: [ self error: 'input nil' ].
      index <= input size
        ifTrue:  [ current:: input at: index ]
        ifFalse: [ current:: nil ]
    )

    private startCapture = (
      captureStart:: index
    )

    private pauseCapture = (
      captureBuffer:: captureBuffer , (
        self substringFrom: captureStart to: index - 1).
      captureStart:: -1
    )

    private endCapture = (
      | captured |
      '' = captureBuffer
        ifTrue:  [ captured:: self substringFrom: captureStart to: index - 1 ]
        ifFalse: [
          self pauseCapture.
          captured:: captureBuffer.
          captureBuffer:: '' ].
      captureStart:: -1.

      ^ captured
    )

    (* SOMns `input substringFrom: start to: stop`. *)
    private substringFrom: start to: stop = (
      captureStream reset.
      captureStream skip: start - 1.
      ^ captureStream next: stop - start + 1
    )

    private expected: expected = (
      self isEndOfText ifTrue: [
        self error: 'Unexpected end of input, expected ' , expected asString ].
      self error: 'Expected ' , expected
    )

    private isWhiteSpace = (
      current = 32 ifTrue: [ ^ true ].   (* space *)
      current = 9  ifTrue: [ ^ true ].   (* \t *)
      current = 10 ifTrue: [ ^ true ].   (* \n *)
      current = 13 ifTrue: [ ^ true ].   (* \r *)
      ^ false
    )

    private isDigit = (
      current = 48 ifTrue: [ ^ true ].   (* 0 *)
      current = 49 ifTrue: [ ^ true ].
      current = 50 ifTrue: [ ^ true ].
      current = 51 ifTrue: [ ^ true ].
      current = 52 ifTrue: [ ^ true ].
      current = 53 ifTrue: [ ^ true ].
      current = 54 ifTrue: [ ^ true ].
      current = 55 ifTrue: [ ^ true ].
      current = 56 ifTrue: [ ^ true ].
      current = 57 ifTrue: [ ^ true ].   (* 9 *)
      ^ false
    )

    private isEndOfText = (
      ^ current isNil
    )
  )

  class HashIndexTable = (
  | private hashTable = newArray: 32 withValue: 0. |
  )(
    public at: name put: index = (
      | slot |
      slot:: self hashSlotFor: name.

      index < 255
        ifTrue:  [ hashTable at: slot put: index + 1 ]
        ifFalse: [ hashTable at: slot put: 0 ]
    )

    public at: name = (
      | slot |
      slot:: self hashSlotFor: name.

      (* subtract 1, 0 stands for empty *)
      ^ ((hashTable at: slot) & 255) - 1
    )

    private stringHash: s = (
      (* this is not a proper hash, but sufficient for the benchmark,
         and very portable! *)
      ^ s size * 1402589
    )

    private hashSlotFor: element = (
      ^ ((stringHash: element) & (hashTable size - 1)) + 1
    )
  )

  class JsonValue = ()(
    public isObject  = ( ^ false )
    public isArray   = ( ^ false )
    public isNumber  = ( ^ false )
    public isString  = ( ^ false )
    public isBoolean = ( ^ false )

    public isTrue  = ( ^ false )
    public isFalse = ( ^ false )
    public isNull  = ( ^ false )

    public asObject = (
      ^ self error: 'Unsupported operation, not an object: ' , self asString
    )

    public asArray = (
      ^ self error: 'Unsupported operation, not an array: ' , self asString
    )
  )

  class JsonArray = JsonValue (
  | private values = Vector new. |
  )(
    public add: value = (
      value isNil ifTrue: [ self error: 'value is null' ].
      values append: value
    )

    public size = (
      ^ values size
    )

    public at: index = (
      ^ values at: index
    )

    public isArray = (
      ^ true
    )

    public asArray = (
      ^ self
    )
  )

  class JsonLiteral new: val = JsonValue (
  | private value  = val.
    public isNull  = 'null'  = val.
    public isTrue  = 'true'  = val.
    public isFalse = 'false' = val.
  |)(
    public asString  = ( ^ value )
    public isBoolean = ( ^ isTrue or: [ isFalse ] )
  )

  class JsonNumber new: aString = JsonValue (
  | private string = aString. |
    aString isNil ifTrue: [ self error: 'string is null' ].
  )(
    public asString = ( ^ string )
    public isNumber = ( ^ true )
  )

  class JsonObject = JsonValue (
  | private names  = Vector new.
    private values = Vector new.
    private table  = HashIndexTable new. |
  )(
    public add: name with: aJsonValue = (
      name isNil ifTrue: [ self error: 'name is null' ].
      aJsonValue isNil ifTrue: [ self error: 'aJsonValue is null' ].

      table at: name put: names size + 1. (* + 1 for 1-based indexing *)
      names  append: name.
      values append: aJsonValue
    )

    public at: name = (
      | idx |
      name isNil ifTrue: [ self error: 'name is null' ].
      idx:: self indexOf: name.
      idx = 0
        ifTrue:  [ ^ nil ]
        ifFalse: [ ^ values at: idx ]
    )

    public size = (
      ^ names size
    )

    public isEmpty = (
      ^ names isEmpty
    )

    public isObject = ( ^ true )
    public asObject = ( ^ self )

    private indexOf: name = (
      | idx |
      idx:: table at: name.
      ((idx = 0) not and: [ name = (names at: idx) ]) ifTrue: [ ^ idx ].
      ^ self error: 'not implement'
    )
  )

  class JsonString new: str = JsonValue (
  | private string = str. |
  )(
    public isString = ( ^ true )
  )

  (* ---- What nsl's Integer and Array lack (AWFY.md §Dialect) ---- *)

  abs: x = ( ^ x < 0 ifTrue: [ 0 - x ] ifFalse: [ x ] )
  max: a with: b = ( ^ a > b ifTrue: [ a ] ifFalse: [ b ] )
  min: a with: b = ( ^ a < b ifTrue: [ a ] ifFalse: [ b ] )

  (* NBody's module constants Pi, DaysPerYear and SolarMass, as methods: a capitalised implicit
     send resolves as a global in nsl, so the names are lower-cased. *)
  pi          = ( ^ 3.141592653589793 )
  daysPerYear = ( ^ 365.24 )
  solarMass   = ( ^ 4.0 * pi * pi )

  (* Array new: n withAll: aBlock — the block is evaluated once per element. *)
  newArray: n withAll: aBlock = (
    | a |
    a:: Array new: n.
    1 to: n do: [ :i | a at: i put: aBlock value ].
    ^ a
  )
  (* Array new: n withAll: aValue — one value in every element. *)
  newArray: n withValue: v = (
    | a |
    a:: Array new: n.
    1 to: n do: [ :i | a at: i put: v ].
    ^ a
  )
  swap: anArray at: i with: j = (
    | t |
    t:: anArray at: i.
    anArray at: i put: (anArray at: j).
    anArray at: j put: t
  )

  (* ---- CD's module helpers: what nsl's Float lacks (sin, cos, asInteger, IEEE x / 0.0) ---- *)

  (* Float>>asInteger: truncation toward zero, built by binary descent (no Float-to-Integer prim). *)
  asInteger: f = (
    | m p n |
    m:: f < 0 ifTrue: [ 0.0 - f ] ifFalse: [ f ].
    p:: 1.
    [ (p * 2) <= m ] whileTrue: [ p:: p * 2 ].
    n:: 0.
    [ p >= 1 ] whileTrue: [
      (n + p) <= m ifTrue: [ n:: n + p ].
      p:: p // 2 ].
    ^ f < 0 ifTrue: [ 0 - n ] ifFalse: [ n ]
  )

  (* Float / Float with IEEE's answer for a zero divisor (nsl traps it): CD divides by an
     aircraft's motion, which is zero in the frame it appears. x / 0.0 answers +-infinity, and
     0.0 / 0.0 a NaN (inf - inf); nsl's ordered compares do not honour NaN, but CD's inputs never
     reach 0.0 / 0.0 (a voxel edge minus 0.5 never equals an aircraft's start coordinate). *)
  fdiv: a by: b = (
    | inf |
    (b = 0.0) ifFalse: [ ^ a / b ].
    inf:: 2.0.
    1 to: 11 do: [ :i | inf:: inf * inf ].
    a > 0.0 ifTrue: [ ^ inf ].
    a < 0.0 ifTrue: [ ^ 0.0 - inf ].
    ^ inf - inf
  )

  (* Float>>sin and Float>>cos: fdlibm's kernel polynomials after a Cody-Waite reduction by pi/2;
     within an ulp of libm over CD's range (0..20). *)
  sin: x = (
    x < 0.0 ifTrue: [ ^ 0.0 - (sin: 0.0 - x) ].
    ^ trig: x quadrantOffset: 0
  )
  cos: x = (
    x < 0.0 ifTrue: [ ^ cos: 0.0 - x ].
    ^ trig: x quadrantOffset: 1
  )
  private trig: x quadrantOffset: k = (
    | n r q |
    n:: asInteger: (x * 0.636619772367581382433) + 0.5.
    r:: (x - (n * 1.57079632673412561417)) - (n * 0.0000000000607710050650619224932).
    q:: (n + k) & 3.
    q = 0 ifTrue: [ ^ kernelSin: r ].
    q = 1 ifTrue: [ ^ kernelCos: r ].
    q = 2 ifTrue: [ ^ 0.0 - (kernelSin: r) ].
    ^ 0.0 - (kernelCos: r)
  )
  private kernelSin: x = (
    | z p |
    z:: x * x.
    p:: 0.00833333333332248946124 + (z * (-0.000198412698298579493134 + (z * (0.00000275573137070700676789
          + (z * (-0.0000000250507602534068634195 + (z * 0.000000000158969099521155010221))))))).
    ^ x + ((z * x) * (-0.166666666666666324348 + (z * p)))
  )
  private kernelCos: x = (
    | z r qx |
    z:: x * x.
    r:: z * (0.0416666666666666019037 + (z * (-0.00138888888888741095749 + (z * (0.0000248015872894767294178
          + (z * (-0.000000275573143513906633035 + (z * (0.0000000020875723212981748279
          + (z * -0.0000000000113596475577881948265)))))))))).
    z < 0.09 ifTrue: [ ^ 1.0 - ((0.5 * z) - (z * r)) ].
    (* 1 - qx exact, as fdlibm arranges it *)
    qx:: z > 0.6103515625
      ifTrue: [ 0.28125 ]
      ifFalse: [ (asInteger: z * 256.0) / 1024.0 ].
    ^ (1.0 - qx) - (((0.5 * z) - qx) - (z * r))
  )

  treeMinimum: x = (
    | current |
    current:: x.
    [ current left notNil ] whileTrue: [
      current:: current left ].
    ^ current
  )

  (* ---- The run: one row per benchmark, innerIterations sized for a board ---- *)

  (* The one clock read. awfy-soup.py replaces this method for Primordial Soup. *)
  millisecondsToRun: aBlock = (
    | t0 |
    t0:: 0 millis.
    aBlock value.
    ^ 0 millis - t0
  )

  public run: name bench: bench inner: n = (
    | ok ms |
    ms:: millisecondsToRun: [ ok:: bench innerBenchmarkLoop: n ].
    (name , ': ' , ms printString) out.
    ^ ok
  )

  public runAll = (
    | ok |
    ok:: true.
    (run: 'Bounce'  bench: Bounce new  inner: 1) ifFalse: [ ok:: false ].
    (run: 'List'    bench: List new    inner: 1) ifFalse: [ ok:: false ].
    (run: 'Permute' bench: Permute new inner: 1) ifFalse: [ ok:: false ].
    (run: 'Storage' bench: Storage new inner: 1) ifFalse: [ ok:: false ].
    (run: 'Richards' bench: Richards new inner: 1) ifFalse: [ ok:: false ].
    (run: 'Queens'     bench: Queens new     inner: 1)   ifFalse: [ ok:: false ].
    (run: 'Sieve'      bench: Sieve new      inner: 1)   ifFalse: [ ok:: false ].
    (run: 'Towers'     bench: Towers new     inner: 1)   ifFalse: [ ok:: false ].
    (run: 'Mandelbrot' bench: Mandelbrot new inner: 500) ifFalse: [ ok:: false ].
    (run: 'NBody'      bench: NBody new      inner: 1)   ifFalse: [ ok:: false ].
    (run: 'CD'         bench: CD new         inner: 10)  ifFalse: [ ok:: false ].
    (run: 'DeltaBlue'  bench: DeltaBlue new  inner: 100) ifFalse: [ ok:: false ].
    (run: 'Json'       bench: Json new       inner: 1)   ifFalse: [ ok:: false ].
    ^ ok
  )
)
public main: platform args: args = (
	| ok |
	ok:: (Awfy usingPlatform: platform) runAll.
	('verified: ' , ok printString) out.
	('done') out.
)
) : (
)
